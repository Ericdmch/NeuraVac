<?xml version="1.0"?>
<package format="3">
  <name>neuravac_ros</name>
  <version>0.1.0</version>
  <description>ROS 2 serial bridge and web gateway for the NeuraVac Roomba.</description>
  <maintainer email="maintainer@example.com">NeuraVac maintainers</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>python3-flask</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
