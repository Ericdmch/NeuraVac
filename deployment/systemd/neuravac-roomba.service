[Unit]
Description=NeuraVac Roomba driver (USB port)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/Neuravac
ExecStart=/bin/bash -c "source /opt/ros/jazzy/setup.bash; source %h/Neuravac/install/setup.bash; exec ros2 run roomba roomba_node --ros-args --params-file %h/Neuravac/install/roomba/share/roomba/config/roomba_params.yaml -p serial_port:=/dev/serial/by-path/platform-xhci-hcd.0-usb-0:1:1.0-port0"
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
